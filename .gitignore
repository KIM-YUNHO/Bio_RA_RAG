!data/runs/e2e_enumeration_2026-10-15/**/summary.json
!data/runs/e2e_enumeration_2026-10-15/**/*.score.json
data/runs/answer_eval_2026-10-15/baseline/
data/runs/answer_eval_2026-10-15/branch/
data/runs/answer_eval_2026-10-15/paired_dev/

