# ============================================================================
# project_shared 환경 변수 예시 (.env.example) — .env 로 복사한 뒤 값을 채운다
#  - 작성: 2026-10-14 13:46 KST
#  - 이 파일 하나가 프로젝트의 모든 환경 변수를 담는다. 팀 공유는 .env.example 로 한다.
#  - 읽는 곳: rag/llm.py 의 load_env() (ingestion/__init__.py 도 같은 함수로 이 파일을 읽는다).
#    이미 셸에 설정된 값이 우선하며, 빈 값은 무시된다.
#  - docker compose 는 --env-file 로 이 파일을 넘긴다:
#      docker compose --env-file .env -f ingestion/db/compose.yaml up -d
#  - 절대 커밋하지 않는다 (.gitignore 에 포함).
# ============================================================================

# ----------------------------------------------------------------------------
# [1] LLM — 질문 해석·답변 생성(rag/), 적재 요청 에이전트 파싱(ingestion/agent.py → rag.llm)
# ----------------------------------------------------------------------------
# openai (기본) 또는 ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 비워 두면 api.openai.com
OPENAI_BASE_URL=

# LLM_PROVIDER=ollama 일 때만 사용
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_REASONING_EFFORT=none

LLM_TEMPERATURE=0
LLM_SEED=0
LLM_TIMEOUT=120

# ----------------------------------------------------------------------------
# [2] DATABASE — PostgreSQL 17 + pgvector 0.8 (ingestion/db.py, ingestion/db/compose.yaml)
#     현재: 적재 에이전트·카탈로그 미러(registry/corpus/ingest 스키마)만 사용.
#     향후: RAG 청크·벡터·대화 세션도 이 DB로 통합 (docs/project/PGVECTOR_INTEGRATION_MAP_2026-10-14.md)
# ----------------------------------------------------------------------------
# 파이썬 코드가 접속에 쓰는 URL (ingestion/db.py 기본값과 동일)
BIOSIM_DATABASE_URL=postgresql://biosim:biosim_local@127.0.0.1:5432/biosim
# compose.yaml 이 컨테이너를 만들 때 쓰는 값. 바꾸면 위 URL 의 비밀번호·포트도 같이 바꾼다.
BIOSIM_DB_PASSWORD=biosim_local
BIOSIM_DB_PORT=5432

# --- [2-b] pgvector 통합 예약 변수: 아직 어떤 코드도 읽지 않는다 (통합 작업 때 사용) ---
# BIOSIM_VECTOR_SCHEMA=rag
# BIOSIM_EMBEDDING_MODEL=BAAI/bge-m3
# BIOSIM_EMBEDDING_DIM=1024
# BIOSIM_VECTOR_DISTANCE=inner_product   # rag/search.py ranks by inner product; pgvector <#> + vector_ip_ops (storage/HANDOFF.md)
# BIOSIM_VECTOR_RELEASE=03_pipeline_h_v2_table_recovery_2026_10_14
# --- read by rag/search.py: BIOSIM_SEARCH_BACKEND=postgres loads chunks and vectors of a loaded release from the database ---
# BIOSIM_SEARCH_BACKEND=postgres
# --- read by rag/portable_paths.py: original = keep the original project's absolute paths found in manifests (default: use this project's copies) ---
# BIOSIM_PATHS=original
# BIOSIM_SESSION_STORE=postgres

# ----------------------------------------------------------------------------
# [3] DATA RELEASE — 적재 에이전트가 "현재 서비스 색인"으로 비교하는 릴리스 (ingestion/registry.py)
#     서비스 시작 스크립트(scripts/start_ra_service.ps1)는 자체 경로를 쓴다.
# ----------------------------------------------------------------------------
BIOSIM_ACTIVE_RELEASE=data/versions/01_pilot_baseline_2026-10-10/embedded/rag_finalization_2026-10-10_v2

# ----------------------------------------------------------------------------
# [4] 참고용 — 코드가 실행 중에 직접 설정하는 변수 (여기서 바꿀 필요 없음)
# ----------------------------------------------------------------------------
# PROMOTE_PROJECT=            # product_search/promote.py: 사본 프로젝트에 promote 를 시험할 때만
# HF_HUB_OFFLINE=1            # pipeline_h 워커·임베딩: 모델을 로컬 캐시에서만 읽음
# TRANSFORMERS_OFFLINE=1
# PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# COMPARE_CONFIG / COMPARE_RUNS_DIR / COMPARE_TRIGRAM_PATH   # pipeline_h vendor(settings.activate)가 설정
