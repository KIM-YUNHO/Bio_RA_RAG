    {
      "type": "text",
      "ref": "#/texts/5",
      "parent": "#/body",
      "page": 1,
      "bbox": [
        72.3,
        310.1,
        543.1,
        346.5
      ],
      "layer": "body",
      "route": "DIGITAL",
      "source": "text_layer",
      "label": "text",
      "text": "The systemic exposure of ustekinumab (Cmax and AUC) increased in a linear manner following a single subcutaneous administration at doses ranging from approximately 24 mg to 240 mg in patients with psoriasis.",
      "status": "kept",
      "furniture": false,
      "section_path": [
        "10.3 Pharmacokinetics",
        "Dose Linearity"
      ],
      "speaker": "label",
      "redacted": false,
      "study_ids": []
    },
