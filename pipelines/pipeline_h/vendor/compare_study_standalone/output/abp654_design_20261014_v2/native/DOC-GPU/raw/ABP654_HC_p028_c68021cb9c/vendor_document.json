        285.3,
        233.5,
        295.6
      ],
      "layer": "body",
      "route": "DIGITAL",
      "source": "text_layer",
      "label": "section_header",
      "text": "Single Dose vs. Multiple Doses",
      "status": "kept",
      "furniture": false,
      "section_path": [
        "10.3 Pharmacokinetics",
        "Single Dose vs. Multiple Doses"
      ],
      "speaker": "label",
      "redacted": false,
      "study_ids": []
    },
    {
      "type": "text",
      "ref": "#/texts/7",
      "parent": "#/body",
      "page": 1,
      "bbox": [
        72.1,
        178.1,
        547.9,
        277.0
      ],
      "layer": "body",
      "route": "DIGITAL",
      "source": "text_layer",
      "label": "text",
      "text": "Serum concentration - time profiles of ustekinumab were generally predictable after single or multiple subcutaneous dose administrations on the basis of a one-compartment model. In patients with psoriasis, steady-state serum concentrations of ustekinumab were achieved by Week 28 after initial subcutaneous doses at Weeks 0 and 4 followed by doses every 12 weeks. The median steady-state trough concentration ranged from 0.21 mcg/mL to 0.26 mcg/mL (45 mg; n = 242 to 390) and from 0.47 mcg/mL to 0.49 mcg/mL (90 mg; n = 236 to 386) in patients with psoriasis. There was no apparent accumulation in serum ustekinumab concentration over time when given subcutaneously every 12 weeks.",
      "status": "kept",
      "furniture": false,
      "section_path": [
        "10.3 Pharmacokinetics",
        "Single Dose vs. Multiple Doses"
      ],
      "speaker": "label",
      "redacted": false,
      "study_ids": []
    },
