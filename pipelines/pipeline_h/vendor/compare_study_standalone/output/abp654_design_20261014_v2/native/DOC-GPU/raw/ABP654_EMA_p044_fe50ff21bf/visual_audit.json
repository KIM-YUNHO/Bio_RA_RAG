        646.3,
        505.7,
        654.3
      ],
      "layer": "body",
      "route": "MIXED",
      "source": "ocr",
      "label": "text",
      "text": "AUCinf = AUC from time 0 extrapolated to infinity; AUCiast = AUC from time 0 to the last quantifiable concentration; Clast = last measurable serum concentration,",
      "status": "kept"
    },
    {
      "type": "text",
      "ref": "#/texts/3",
      "parent": "#/body",
      "page": 1,
      "bbox": [
        72.3,
        631.6,
        523.0,
        646.3
      ],
      "layer": "body",
      "route": "MIXED",
      "source": "ocr",
      "label": "text",
      "text": "Cmax = maximum observed serum concentration; EU = European Union; Geo CV = geometric coefficient of variation; GM = geometric mean; t1/2 = terminal elimination half-life; Tmax = time at which Cmax is observed; US = United States",
      "status": "kept"
    },
    {
      "type": "text",
      "ref": "#/texts/4",
      "parent": "#/groups/0",
      "page": 1,
      "bbox": [
